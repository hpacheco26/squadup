rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Config collection (read-only for authenticated users)
    match /config/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Players collection
    match /players/{playerId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update: if request.auth != null && request.auth.uid == resource.data.userId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Groups collection
    match /groups/{groupId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/config/allowedCreators).data.uids;
      allow update: if request.auth != null
        && (request.auth.uid == resource.data.adminId
            || (resource.data.adminIds is list && request.auth.uid in resource.data.adminIds)
            || isSelfJoin());
      allow delete: if request.auth != null && request.auth.uid == resource.data.adminId;

      // A non-admin, authenticated user may join a group via invite link by either:
      //  - claiming an existing unlinked player row (replacing it with one that has their userId), or
      //  - appending a brand-new player row for themselves.
      // Only the `players`/`playerIds`/`memberUserIds` fields may change, no existing member may be
      // removed, and at most one player row may be added/changed — this blocks tampering with other members.
      // NOTE: `playerIds` holds internal player ids (see groupService.js), NOT auth UIDs — membership
      // must be checked against `memberUserIds`, which mirrors each linked player's `userId`.
      function isSelfJoin() {
        let newData = request.resource.data;
        let oldData = resource.data;
        let oldPlayers = oldData.players;
        let newPlayers = newData.players;
        let removed = oldPlayers.toSet().difference(newPlayers.toSet());
        let added = newPlayers.toSet().difference(oldPlayers.toSet());
        let oldMemberUserIds = 'memberUserIds' in oldData ? oldData.memberUserIds : [];

        return newData.diff(oldData).affectedKeys().hasOnly(['players', 'playerIds', 'memberUserIds'])
          && !(request.auth.uid in oldMemberUserIds)
          && request.auth.uid in newData.memberUserIds
          && newData.playerIds.hasAll(oldData.playerIds)
          && added.size() == 1
          && removed.size() <= 1
          && newPlayers.size() == oldPlayers.size() + (1 - removed.size());
      }
    }

    // Helper: is the current user an admin of the given group?
    function isGroupAdmin(groupId) {
      let g = get(/databases/$(database)/documents/groups/$(groupId)).data;
      return request.auth.uid == g.adminId
          || (g.adminIds is list && request.auth.uid in g.adminIds);
    }

    // Games collection — any member can update (RSVP, team changes); only group admins can delete
    match /games/{gameId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && isGroupAdmin(resource.data.groupId);
    }

    // Invites collection
    match /invites/{inviteId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.createdBy;
    }

    // Game debts collection — any member can update (mark paid); only group admins can delete
    match /gameDebts/{debtId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && isGroupAdmin(resource.data.groupId);
    }

    // Notifications collection
    match /notifications/{notifId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.recipientIds;
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.recipientIds;
      allow delete: if false;
    }

    // FCM tokens — users can only manage their own token document
    match /fcmTokens/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
