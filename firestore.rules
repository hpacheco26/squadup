rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Config collection (read-only for authenticated users)
    match /config/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Players collection
    match /players/{playerId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update: if request.auth != null && request.auth.uid == resource.data.userId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Groups collection
    match /groups/{groupId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/config/allowedCreators).data.uids;
      allow update: if request.auth != null
        && (request.auth.uid == resource.data.adminId
            || request.auth.uid in resource.data.adminIds);
      allow delete: if request.auth != null && request.auth.uid == resource.data.adminId;
    }

    // Games collection — members of the game's group only
    match /games/{gameId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.adminIds;
      allow delete: if request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.adminIds;
    }

    // Invites collection
    match /invites/{inviteId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.createdBy;
    }

    // Game debts collection — group admins only
    match /gameDebts/{debtId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.adminIds;
      allow delete: if request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.adminIds;
    }

    // Notifications collection
    match /notifications/{notifId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.recipientIds;
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.recipientIds;
      allow delete: if false;
    }

    // FCM tokens — users can only manage their own token document
    match /fcmTokens/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
